[Unit]
Description=JEPA research landscape static public catalogue
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/research/JEPA-research-landscape
ExecStart=%h/research/JEPA-research-landscape/.venv/bin/python -m jepa.serve --publication %h/research/JEPA-research-landscape/runtime/published --port 40173
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
RestrictAddressFamilies=AF_INET AF_INET6
UMask=0077

[Install]
WantedBy=default.target
